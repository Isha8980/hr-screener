OPENAI_API_KEY=
HF_API_TOKEN=

# Recruiter authentication password protecting sensitive recruiter views like /queue
RECRUITER_PASSWORD=your_recruiter_password_here

# Resend API key used to send candidate emails (interview invites/rejections) via
# Resend's HTTPS API (not SMTP -- many hosting platforms, including Render's free
# tier, block outbound SMTP). Get a key at https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here