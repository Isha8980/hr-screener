OPENAI_API_KEY=
HF_API_TOKEN=

# Recruiter authentication password protecting sensitive recruiter views like /queue
RECRUITER_PASSWORD=your_recruiter_password_here

# Gmail account used to send candidate emails (interview invites/rejections) via
# smtp.gmail.com. SMTP_APP_PASSWORD must be a Gmail App Password, not your normal
# account password -- see https://myaccount.google.com/apppasswords
SMTP_EMAIL=your_gmail_address_here
SMTP_APP_PASSWORD=your_gmail_app_password_here